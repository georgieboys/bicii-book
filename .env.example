# BICII Admin environment. Copy to .env.local and fill in. Never commit values.
#
# Every variable in PLAN.md §4 and every variable read by src/lib/env.ts is
# listed here. Locally, `npm run devstack:env` writes the devstack values into
# .env.local for you. Hosted values live in Vercel (app) and GitHub secrets;
# see docs/RUNBOOK.md. All values below are placeholders.

# --- Public (inlined into the browser bundle at build time) -------------------
# Supabase API URL. Local devstack or `supabase start`: http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon (publishable) key. Safe to expose: RLS applies to everything
# it can reach. Local: printed by `npm run devstack:env` / `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# An extra public website base the scanner accepts ({this}/q/{shortId}), so
# labels printed against an earlier address keep scanning. NOT the QR base:
# labels encode and the Admin shows shop_settings.public_site_url (PLAN D9,
# ADR-017), set by an admin in the app.
NEXT_PUBLIC_PUBLIC_SITE_URL=https://bicii.vercel.app

# --- Server only ---------------------------------------------------------------
# Service-role key: BYPASSES RLS. Server only, and imported only from
# src/lib/admin/** (Auth admin API, e.g. inviting staff) and
# src/lib/integrations/** (ESLint enforces this). Required for EVERY staff
# sign-in: each code request and verification is counted with it first
# (PLAN D72), so without it, or with a wrong one, nobody can sign in. Also
# required for Settings -> Staff -> Invite. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# pino level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Tests only: raises the Admin's own sign-in limits (PLAN D72) by this whole
# factor, 1-100000 (default 1). Playwright sets 1000 because the E2E suite
# signs in hundreds of times from one address. Never set it on Vercel.
# SIGN_IN_LIMIT_MULTIPLIER=1

# --- Phase 10: Shopify (docs/RUNBOOK.md "Shopify") ------------------------------
# All optional: with none set, Shopify is off (webhooks answer 503 and are
# kept as rejected evidence; product syncs wait with shopify_not_configured).
# The shop's own domain, <name>.myshopify.com, lower case (webhooks from any
# other shop are refused).
SHOPIFY_SHOP_DOMAIN=
# Admin API access token of the custom app (the live adapter). Secret.
SHOPIFY_ADMIN_TOKEN=
# Webhook signing secret (HMAC check on /api/shopify/webhooks). Secret.
SHOPIFY_WEBHOOK_SECRET=
# live | fake. fake = the in-memory Shopify for local development and E2E:
# never with SHOPIFY_ADMIN_TOKEN, never when VERCEL_ENV=production (env.ts
# refuses both). live (or unset) uses the GraphQL adapter when the domain and
# token are set; live requires both.
SHOPIFY_ADAPTER=
# true ONLY when a Vercel Preview's SHOPIFY_* values belong to a separate
# Shopify development store. Without it the live adapter is off in Preview
# (VERCEL_ENV=preview): a preview build on the staging database must never
# write to the live store. Leave unset everywhere else.
SHOPIFY_ALLOW_PREVIEW=
# Bearer secret of /api/cron/integrations; the Vercel cron (vercel.json) sends
# it as Authorization: Bearer <value>. Unset = the route answers 503. Secret.
CRON_SECRET=

# --- Phase 13: quote emails (docs/RUNBOOK.md "Quote emails") -------------------
# Both optional: with either unset, quotes are sent by WhatsApp or a copied
# link and the Email option is not offered. Resend API key (Secret):
RESEND_API_KEY=
# The sender, on a domain Resend has verified, e.g. BICII <workshop@example.com>
EMAIL_FROM=

# --- Phase 14: Stripe customer payments (docs/RUNBOOK.md "Stripe payments") ---
# All optional. Stripe is on only when every one it needs is valid for this
# deployment (D157); otherwise it is off and Settings → Customer payments
# (Phase 14 step 2) says why: no Pay deposit button, the deposit setting stays
# at 0, and /api/stripe/webhooks answers 503 (kept as rejected evidence).
# Never in a Vercel Preview. Live keys only in Production; test keys only
# elsewhere.
# Secret: restricted (rk_…) or secret (sk_…) key; Checkout Sessions write, Refunds read.
STRIPE_SECRET_KEY=
# Secret: the endpoint's signing secret (whsec_…); test and live differ.
STRIPE_WEBHOOK_SECRET=
# fake = the in-memory Stripe (local development, CI, E2E); refused with a key or in production.
STRIPE_ADAPTER=
# This Admin's origin, no path (http only for localhost): where Stripe sends
# customers back, and the host of every quote link and the Shopify webhook
# address (unset: those two fall back to the request's own host).
ADMIN_ORIGIN=
# --- Vercel ----------------------------------------------------------------------
# Set by Vercel itself (production | preview | development); never set by
# hand. env.ts reads it to refuse SHOPIFY_ADAPTER=fake in production, and the
# Shopify client to keep the live adapter off in Preview (SHOPIFY_ALLOW_PREVIEW).
# Read by Stripe: off in preview, live keys only in production (D157).
# VERCEL_ENV=
# Stable Server Action encryption key across instances and deployments
# (base64, 32 bytes: `openssl rand -base64 32`). Set in Vercel, not locally.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Tooling: SHELL ONLY (export these; .env.local is NOT read for them) -------
# Next.js loads .env.local for the app; the devstack scripts (db:reset,
# db:types, devstack:*), the DB tests and Playwright do not load any .env
# file. Set these in your shell or prefix the command, e.g.
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres npm run db:types
# Postgres for the devstack scripts, DB tests and type generation. The app
# itself never connects directly; it goes through Supabase. Without it, the
# scripts use the libpq variables below (default
# postgres/postgres@127.0.0.1:5432, database bicii_dev). The user must be a
# superuser: the scripts create databases and the Supabase platform roles.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bicii_dev
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=bicii_dev
# PGSSLMODE=           # passed to `supabase gen types`; loopback defaults to disable
# Devstack component cache (default ~/.cache/bicii-devstack) and ports.
# BICII_DEVSTACK_CACHE=
# BICII_GATEWAY_PORT=54321
# BICII_AUTH_PORT=9999
# BICII_REST_PORT=3001
# BICII_STORAGE_PORT=5000
# The devstack's mail catcher, where Supabase Auth sends sign-in codes:
# SMTP port and HTTP API port (scripts/devstack/mailcatcher.mjs).
# BICII_SMTP_PORT=2525
# BICII_MAIL_HTTP_PORT=8025
# Mail API the tests read codes from (default http://127.0.0.1:$BICII_MAIL_HTTP_PORT,
# or http://127.0.0.1:54324 with BICII_MAIL_KIND=mailpit).
# BICII_MAIL_URL=
# Which mail API that is: unset for the devstack's catcher, "mailpit" for the
# Mailpit that `supabase start` runs (with E2E_EXTERNAL_STACK=1).
# BICII_MAIL_KIND=mailpit
# Devstack JWT secret (default: the well-known Supabase local demo secret) and
# the password of the platform login roles (must match roles.sql: postgres).
# BICII_JWT_SECRET=
# BICII_SERVICE_ROLE_PASSWORD=postgres
# Gateway the live-stack smoke test talks to (default http://127.0.0.1:54321).
# BICII_STACK_URL=
# DB tests against an existing migrated + seeded database instead of clones.
# BICII_TEST_DATABASE_URL=
# Make the live-stack smoke test fail instead of skipping (CI sets it).
# BICII_REQUIRE_STACK=1
# Playwright: app port (3100), reuse a running app, skip the bicii_dev reset,
# use a stack it does not manage, or point at a specific Chromium binary.
# E2E_PORT=3100
# E2E_REUSE_SERVER=1
# E2E_RESET=0
# E2E_EXTERNAL_STACK=1   # use `supabase start` (already reset) instead of the devstack
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
