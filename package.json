{
  "name": "bicii-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:types": "node scripts/devstack/db.mjs types --fresh && git diff --exit-code -- src/lib/database.types.ts",
    "test:unit": "vitest run --project unit",
    "test": "vitest run",
    "tokens:contrast": "node scripts/contrast.mjs",
    "test:db": "vitest run --project db",
    "devstack:setup": "node scripts/devstack/setup.mjs",
    "devstack:start": "node scripts/devstack/start.mjs",
    "devstack:stop": "node scripts/devstack/stop.mjs",
    "devstack:status": "node scripts/devstack/status.mjs",
    "devstack:env": "node scripts/devstack/env.mjs",
    "db:reset": "node scripts/devstack/db.mjs reset",
    "db:migrate": "node scripts/devstack/db.mjs migrate",
    "db:types": "node scripts/devstack/db.mjs types",
    "icons": "node scripts/icons.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "decimal.js": "^10.6.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
